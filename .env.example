# MagdalenaBot Configuration

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Default email for testing
DEFAULT_ENGINEER_EMAIL=ingeniero@example.com

# n8n Webhook URL for email sending
N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook/magdalenabot/send-analysis

# Optional: Email configuration (if sending directly)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
