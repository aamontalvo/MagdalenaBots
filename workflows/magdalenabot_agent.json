        "jsCode": "// Parse webhook input for agent\nconst body = $input.first().json.body || {};\n\n// Extract message from various formats\nconst message = body.last_input_text || body.message || body.text || body.query;\n\n// Extract session ID for memory\nconst sessionId = body.id || body.session_id || body.user_id || 'default';\n\n// Extract email if provided\nconst email = body.email || body.user_email;\n\nreturn [{\n  json: {\n    text: message,\n    session_id: sessionId,\n    email: email,\n    original_body: body\n  }\n}];"
